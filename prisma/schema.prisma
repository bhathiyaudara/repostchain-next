model Faq {
  id              BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  sort_order      BigInt      @default(0) @db.UnsignedBigInt
  faq_category_id BigInt      @default(1) @db.UnsignedBigInt
  question        String      @db.VarChar(255)
  description     String      @db.VarChar(255)
  status          Int         @default(1) @db.TinyInt
  created_at      DateTime?   @db.Timestamp(0)
  updated_at      DateTime?   @db.Timestamp(0)
  deleted_at      DateTime?   @db.Timestamp(0)
  created_by      BigInt?     @db.UnsignedBigInt
  updated_by      BigInt?     @db.UnsignedBigInt
  deleted_by      BigInt?     @db.UnsignedBigInt

  category        FaqCategory @relation(fields: [faq_category_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([faq_category_id])
  @@index([status])
  @@map("faqs")
}

model ApplicationSetting {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  key        String    @unique @db.VarChar(255)
  env_key    String?   @db.VarChar(255)
  value      String?   @db.Text
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  deleted_at DateTime? @db.Timestamp(0)
  created_by BigInt?   @db.UnsignedBigInt
  updated_by BigInt?   @db.UnsignedBigInt
  deleted_by BigInt?   @db.UnsignedBigInt

  @@index([key])
  @@map("application_settings")
}

model Contact {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  sort_order BigInt    @default(0) @db.UnsignedBigInt
  name       String    @db.VarChar(255)
  email      String    @db.VarChar(255)
  subject    String    @db.VarChar(255)
  message    String?   @db.Text
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  deleted_at DateTime? @db.Timestamp(0)
  created_by BigInt?   @db.UnsignedBigInt
  updated_by BigInt?   @db.UnsignedBigInt
  deleted_by BigInt?   @db.UnsignedBigInt

  @@map("contacts")
}

model Referral {
  id                       BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  referrer_urn             String    @db.VarChar(255)
  referred_urn             String    @unique @db.VarChar(255)
  status                   Int       @default(0) @db.TinyInt
  credits_awarded_referrer Int       @default(0) @db.UnsignedInt
  credits_awarded_referred Int       @default(0) @db.UnsignedInt
  completed_at             DateTime? @db.Timestamp(0)
  created_at               DateTime? @db.Timestamp(0)
  updated_at               DateTime? @db.Timestamp(0)

  @@index([referrer_urn])
  @@index([status])
  @@map("referrals")
}

model Conversation {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_one_urn    String    @db.VarChar(255)
  user_two_urn    String    @db.VarChar(255)
  last_message_at DateTime? @db.Timestamp(0)
  pinned_by_one   Boolean   @default(false)
  pinned_by_two   Boolean   @default(false)
  created_at      DateTime? @db.Timestamp(0)
  updated_at      DateTime? @db.Timestamp(0)
  deleted_at      DateTime? @db.Timestamp(0)

  messages        Message[]

  @@unique([user_one_urn, user_two_urn])
  @@index([user_one_urn])
  @@index([user_two_urn])
  @@map("conversations")
}

model Message {
  id              BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  conversation_id BigInt       @db.UnsignedBigInt
  sender_urn      String       @db.VarChar(255)
  body            String       @db.Text
  read_at         DateTime?    @db.Timestamp(0)
  created_at      DateTime?    @db.Timestamp(0)
  updated_at      DateTime?    @db.Timestamp(0)
  deleted_at      DateTime?    @db.Timestamp(0)

  conversation    Conversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@index([sender_urn])
  @@map("messages")
}
