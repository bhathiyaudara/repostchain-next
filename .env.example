# 1. MySQL Database Connection (Same database as Laravel app — ZERO schema destruction)
DATABASE_URL="mysql://your_db_user:your_db_password@127.0.0.1:3306/u872400440_repostchain"

# 2. Laravel App Key & Next.js JWT Secret
APP_KEY="base64:your_laravel_app_key_here"
JWT_SECRET="your_jwt_secret_here"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. SoundCloud OAuth 2.1 API Credentials
SOUNDCLOUD_CLIENT_ID="your_soundcloud_client_id"
SOUNDCLOUD_CLIENT_SECRET="your_soundcloud_client_secret"
SOUNDCLOUD_REDIRECT_URI="http://localhost:3000/auth/soundcloud/callback"

# 4. Stripe & PayPal Credentials (configured via Vercel Environment Variables)
STRIPE_KEY="your_stripe_publishable_key"
STRIPE_SECRET="your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="your_stripe_webhook_secret"
PAYPAL_MODE="sandbox"
PAYPAL_SANDBOX_CLIENT_ID="your_paypal_client_id"
PAYPAL_SANDBOX_CLIENT_SECRET="your_paypal_client_secret"
